# Postgres connection string
DATABASE_URL=postgres://wagonwheel:wagonwheel_dev@localhost:5432/wagonwheel

# Server
PORT=3000

# Flat fee (in cents) added to every booking, on top of nights * nightly rate
BOOKING_FEE_CENTS=500

# Square (get these from the Square Developer Dashboard: https://developer.squareup.com/apps)
# Use your app's SANDBOX values until you're ready to go live.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# Admin email notification, sent when a booking is confirmed.
# Without ADMIN_EMAIL, notifications are skipped. Without SMTP_HOST, they're logged
# to the server console instead of actually sent (useful for local dev).
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=bookings@wagonwheelrv.example

# Admin reservations view at /admin (session-cookie login). Required to use /admin and /api/admin/*.
# Pick a strong, unique password -- do not use "admin" or anything guessable once this
# is reachable by anyone other than you. The server warns on startup if it looks weak.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Web push notifications to /admin (Windows/Android/iOS via browser push -- no native
# app or app-store account needed). Generate a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these set, push notifications are skipped (admin email still sends).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wagonwheelrv.example

# Escalation phone call, placed when a booking alert goes unacknowledged (SignalWire).
# All five must be set or calls are skipped entirely -- push and email are unaffected.
# Space URL and Project ID come from the SignalWire dashboard; the API token is created under
# API > Credentials. FROM must be a number on the account; ALERT_CALL_NUMBERS is who gets rung,
# comma-separated. On a trial project every destination must be verified first.
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_FROM_NUMBER=
ALERT_CALL_NUMBERS=
# Which push attempt escalates to a call. Default 3, i.e. ~10 minutes of being ignored.
ALERT_CALL_AFTER_ATTEMPT=3
