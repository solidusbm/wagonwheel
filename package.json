    "seed": "psql \"$DATABASE_URL\" -f db/seed.sql"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "square": "^45.0.1",
    "web-push": "^3.6.7"
  }
}
