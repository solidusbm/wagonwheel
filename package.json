{
  "name": "wagonwheel-rv-park",
  "version": "0.1.0",
  "private": true,
  "description": "Booking and payments site for Bandera Wagon Wheel RV Park",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
